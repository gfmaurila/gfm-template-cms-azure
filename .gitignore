## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ============================================================
# FRONT-END - NODE.JS / REACT / VITE / TYPESCRIPT
# ============================================================

node_modules/
**/node_modules/

# Package manager caches/logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/
.pnp.*
.bun/

# Os lock files devem ser versionados:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# bun.lock

# React / Vite builds
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
vite.config.*.timestamp-*
vite.config.*.mjs

# TypeScript
*.tsbuildinfo

# Front-end caches
.cache/
**/.cache/
.parcel-cache/
.turbo/
.nx/
.eslintcache
.stylelintcache

# Frameworks opcionais
.next/
.nuxt/
.output/
.svelte-kit/

# Storybook
storybook-static/

# ============================================================
# TESTES FRONT-END
# ============================================================

coverage/
**/coverage/
playwright-report/
**/playwright-report/
test-results/
**/test-results/
blob-report/
cypress/screenshots/
cypress/videos/
cypress/downloads/

# ============================================================
# FRONT-END - ARQUIVOS GERADOS / TEMPORÁRIOS
# ============================================================

*.local
*.tmp
*.temp
*.map
*.gz
*.br

# ============================================================
# ENV / CONFIGURAÇÕES / SECRETS
# ============================================================

.env.*
**/.env
**/.env.*

# Manter templates de configuração no Git
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

secrets/
**/secrets/
*.secret
*.secrets
*.key
*.pem
*.pfx
*.p12

!*.example.pem
!*.example.key

# ============================================================
# DOCKER / CONTAINERS
# ============================================================

# Dockerfile, docker-compose*.yml e configurações oficiais
# permanecem versionados. Ignorar somente runtime/local data.
docker-data/
**/docker-data/
.docker-data/
volumes/
**/volumes/
docker-compose.local.yml
docker-compose.*.local.yml

# ============================================================
# TERRAFORM / OPENTOFU
# ============================================================

.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# .terraform.lock.hcl deve ser versionado.

# ============================================================
# AZURE / AZURITE / SERVERLESS
# ============================================================

.azure/
.azurefunctions/
.func/
.azurite/
**/.azurite/
.azure-env/
**/.azure-env/
ARM_TEMPLATE_OUTPUT.json
*.azuredeploy.*
.arm/

# .bicepparam, main.bicepparam e outputs versionados de IaC
# permanecem rastreados.

# ============================================================
# N8N
# ============================================================

.n8n/
**/.n8n/

# Workflows destinados ao projeto devem ser exportados para
# uma pasta versionada, por exemplo: n8n/workflows/

# ============================================================
# IDEs / EDITORES
# ============================================================

.vs/
.idea/

.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
!.vscode/tasks.json
!.vscode/launch.json

*.user
*.suo
*.userosscache
*.sln.docstates

# ============================================================
# SISTEMA OPERACIONAL
# ============================================================

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# TEMPORÁRIOS E LOGS
# ============================================================

*.bak
*.swp
*.swo
*.orig
*.log

# ============================================================
# TEMPORÁRIOS DE DIAGRAMA (Draw.io / Excalidraw)
# ============================================================
# Os .drawio oficiais devem permanecer versionados.

*.drawio.bkp
*.drawio.tmp
*~
